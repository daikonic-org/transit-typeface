featurePrefixes = (
{
code = "languagesystem DFLT dflt;\012languagesystem latn dflt;\012lookup Form_leftDouble { sub less less hyphen by code.leftDouble; } Form_leftDouble;\012lookup Form_arrowDouble { sub hyphen greater greater by code.arrowDouble; } Form_arrowDouble;\012lookup Form_notStrict { sub exclam equal equal by code.notStrict; } Form_notStrict;\012lookup Form_strictEqual { sub equal equal equal by code.strictEqual; } Form_strictEqual;\012lookup Form_arrow { sub hyphen greater by code.arrow; } Form_arrow;\012lookup Form_leftArrow { sub less hyphen by code.leftArrow; } Form_leftArrow;\012lookup Form_lessEqual { sub less equal by code.lessEqual; } Form_lessEqual;\012lookup Form_greaterEqual { sub greater equal by code.greaterEqual; } Form_greaterEqual;\012lookup Form_scope { sub colon colon by code.scope; } Form_scope;\012lookup Form_fatArrow { sub equal greater by code.fatArrow; } Form_fatArrow;\012lookup Form_equal { sub equal equal by code.equal; } Form_equal;\012lookup Form_notEqual { sub exclam equal by code.notEqual; } Form_notEqual;";
name = "<anonymous>";
},
{
code = "table GDEF {\012  LigatureCaretByPos code.leftDouble 600 1200;\012  LigatureCaretByPos code.arrowDouble 600 1200;\012  LigatureCaretByPos code.notStrict 600 1200;\012  LigatureCaretByPos code.strictEqual 600 1200;\012  LigatureCaretByPos code.arrow 600;\012  LigatureCaretByPos code.leftArrow 600;\012  LigatureCaretByPos code.lessEqual 600;\012  LigatureCaretByPos code.greaterEqual 600;\012  LigatureCaretByPos code.scope 600;\012  LigatureCaretByPos code.fatArrow 600;\012  LigatureCaretByPos code.equal 600;\012  LigatureCaretByPos code.notEqual 600;\012} GDEF;";
name = "<anonymous>";
}
);
features = (
{
code = "lookup Match_0 {\012  ignore sub [hyphen less] less' less hyphen, less' less hyphen [hyphen greater equal];\012  sub less' lookup Form_leftDouble less hyphen;\012 } Match_0;\012 lookup Match_1 {\012  ignore sub [hyphen less] hyphen' greater greater, hyphen' greater greater [greater equal];\012  sub hyphen' lookup Form_arrowDouble greater greater;\012 } Match_1;\012 lookup Match_2 {\012  ignore sub [exclam equal less greater] exclam' equal equal, exclam' equal equal [equal greater];\012  sub exclam' lookup Form_notStrict equal equal;\012 } Match_2;\012 lookup Match_3 {\012  ignore sub [exclam equal less greater] equal' equal equal, equal' equal equal [equal greater];\012  sub equal' lookup Form_strictEqual equal equal;\012 } Match_3;\012 lookup Match_4 {\012  ignore sub [hyphen less] hyphen' greater, hyphen' greater [greater equal];\012  sub hyphen' lookup Form_arrow greater;\012 } Match_4;\012 lookup Match_5 {\012  ignore sub [hyphen less] less' hyphen, less' hyphen [hyphen greater equal];\012  sub less' lookup Form_leftArrow hyphen;\012 } Match_5;\012 lookup Match_6 {\012  ignore sub [exclam equal less greater] less' equal, less' equal [equal greater less];\012  sub less' lookup Form_lessEqual equal;\012 } Match_6;\012 lookup Match_7 {\012  ignore sub [exclam equal less greater] greater' equal, greater' equal [equal greater less];\012  sub greater' lookup Form_greaterEqual equal;\012 } Match_7;\012 lookup Match_8 {\012  ignore sub colon colon' colon, colon' colon colon;\012  sub colon' lookup Form_scope colon;\012 } Match_8;\012 lookup Match_9 {\012  ignore sub [exclam equal less greater] equal' greater, equal' greater [greater equal];\012  sub equal' lookup Form_fatArrow greater;\012 } Match_9;\012 lookup Match_10 {\012  ignore sub [exclam equal less greater] equal' equal, equal' equal [equal greater];\012  sub equal' lookup Form_equal equal;\012 } Match_10;\012 lookup Match_11 {\012  ignore sub [exclam equal less greater] exclam' equal, exclam' equal [equal greater];\012  sub exclam' lookup Form_notEqual equal;\012 } Match_11;";
name = calt;
}
);
